// Worker só com arquivos estáticos. AINDA SEM ROUTE: o Worker existe para os previews das
// branches, mas não responde em endereço público. No lançamento da Biblioteca entra a route
//   "routes": [ { "pattern": "taioe.com.br/biblioteca*", "zone_name": "taioe.com.br" } ]
// (contrato da origem, no README do taioe-hub).
{
  "name": "taioe-biblioteca",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "assets": { "directory": "./public", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" }
}
