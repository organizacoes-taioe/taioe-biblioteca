{
 "verbetes": {
  "le": {
   "lema": "le",
   "classe": "artigo definido",
   "forma": "masculino singular",
   "def": [
    "Determinante que marca um substantivo masculino singular, referindo-se a uma única entidade possível num contexto."
   ]
  },
  "le#2": {
   "lema": "le",
   "classe": "pronome pessoal",
   "def": [
    "Pronome que representa aquele (pessoa ou objeto) de quem se fala. Usado como complemento direto: o."
   ],
   "nota": "Vem antes do verbo («elle le vit») ou, depois do imperativo, ligado por hífen («faites-le empailler»: mandai empalhá-lo). Pode retomar também uma ideia inteira, como em «pour le savoir»: para sabê-lo."
  },
  "la": {
   "lema": "la",
   "classe": "artigo definido",
   "forma": "feminino singular",
   "def": [
    "Feminino singular de «le». Determina um grupo nominal feminino singular."
   ]
  },
  "la#2": {
   "lema": "la",
   "classe": "pronome pessoal",
   "forma": "feminino singular",
   "def": [
    "Feminino singular de «le». Representa um grupo nominal feminino singular, complemento direto: a."
   ],
   "nota": "Vem antes do verbo («il la renversa»: derrubou-a) ou do infinitivo («la reconduire»: reconduzi-la)."
  },
  "les": {
   "lema": "les",
   "classe": "artigo definido",
   "forma": "plural",
   "def": [
    "Plural de «le» ou «la»."
   ]
  },
  "les#2": {
   "lema": "les",
   "classe": "pronome pessoal",
   "forma": "plural",
   "def": [
    "Pronome pessoal da 3ª pessoa do plural, no acusativo (complemento direto): os, as."
   ],
   "nota": "Vem antes do verbo («elle les portait»: levava-os) ou do infinitivo («de les baiser»: de beijá-los)."
  },
  "l’": {
   "lema": "l’",
   "classe": "artigo definido",
   "forma": "elisão de «le» ou «la»",
   "def": [
    "Elisão dos artigos definidos «le» e «la» diante de vogal ou de h mudo."
   ]
  },
  "l’#2": {
   "lema": "l’",
   "classe": "pronome pessoal",
   "forma": "elisão de «le» ou «la»",
   "def": [
    "Elisão dos pronomes pessoais «la» e «le» diante de vogal ou de h mudo, complemento direto: o, a."
   ],
   "nota": "Vem antes do verbo: «il l’embrassa» é «beijou-o» ou «beijou-a», conforme a pessoa de quem se fala."
  },
  "l’#3": {
   "lema": "l’on",
   "classe": "pronome pessoal",
   "def": [
    "(Literário, formal) «On»: pronome indefinido de sujeito, a gente, se."
   ],
   "nota": "O «l’» aqui é só eufonia: «l’on voyait» é o mesmo que «on voyait»; não é artigo nem pronome complemento e não se traduz."
  },
  "un": {
   "lema": "un",
   "classe": "artigo indefinido",
   "forma": "masculino singular",
   "def": [
    "Determinante colocado diante de um substantivo que representa um objeto, animado ou inanimado, que não se conhece com precisão. Frequentemente: «um entre outros»."
   ]
  },
  "un#2": {
   "lema": "un",
   "classe": "adjetivo numeral",
   "def": [
    "(Anteposto) Marca a unidade, o fato de uma pessoa ou coisa ser só uma, única em sua espécie: um."
   ],
   "nota": "Aqui conta, em vez de apenas indicar: «pas un arbre» é «nem uma árvore»; «un seul mot», «uma só palavra»."
  },
  "un#3": {
   "lema": "un",
   "classe": "pronome indefinido",
   "def": [
    "Uma pessoa ou coisa entre várias outras."
   ],
   "nota": "Usado sozinho: «un de ses amis» (um de seus amigos), «l’un… l’autre» (um… o outro), «un à un» (um a um)."
  },
  "une": {
   "lema": "un",
   "classe": "artigo indefinido",
   "forma": "feminino singular",
   "def": [
    "Determinante colocado diante de um substantivo que representa um objeto, animado ou inanimado, que não se conhece com precisão. Frequentemente: «um entre outros»."
   ]
  },
  "une#2": {
   "lema": "un",
   "classe": "pronome indefinido",
   "forma": "feminino singular",
   "def": [
    "Uma pessoa ou coisa entre várias outras."
   ],
   "nota": "Usado sozinho: «une d’elles» (uma delas), «l’une sur l’autre» (uma sobre a outra)."
  },
  "des": {
   "lema": "des",
   "classe": "artigo indefinido",
   "forma": "plural",
   "def": [
    "Artigo indefinido do plural. É assim o plural de «un» ou «une»."
   ]
  },
  "des#2": {
   "lema": "des",
   "classe": "artigo definido",
   "forma": "contração de «de» + «les»",
   "def": [
    "Contração do artigo definido plural «les» com a preposição «de»: dos, das."
   ],
   "nota": "O «de» é exigido pela palavra anterior (substantivo, verbo ou locução): «le retour des barques» é «a volta dos barcos»."
  },
  "du": {
   "lema": "du",
   "classe": "artigo definido",
   "forma": "contração de «de» + «le»",
   "def": [
    "Artigo contraído, formado pela preposição «de» e pelo artigo «le»: do."
   ]
  },
  "du#2": {
   "lema": "du",
   "classe": "artigo partitivo",
   "def": [
    "Uma quantidade indefinida de. Usado com um substantivo não contável."
   ],
   "nota": "«Il lui paya du cidre»: pagou-lhe cidra (um pouco de cidra). Em português costuma ficar sem artigo."
  },
  "de": {
   "lema": "de",
   "classe": "preposição",
   "def": [
    "Marca a origem, a procedência; indica a posse (o genitivo) e a associação a uma matéria: de."
   ]
  },
  "de#2": {
   "lema": "de",
   "classe": "artigo partitivo",
   "def": [
    "Indica ausência ou quantidade indeterminada. Usado depois de um advérbio de negação ou de quantidade («pas de», «beaucoup de»); também variante de «des» diante de adjetivo."
   ],
   "nota": "Aqui não é a preposição comum: «peu de temps après» é «pouco tempo depois»; «de grands serments», «grandes juramentos»; «de la galette», «galette»."
  },
  "de#3": {
   "lema": "de",
   "classe": "preposição",
   "def": [
    "Seguida de um infinitivo, serve para completar palavras que exprimem uma ação ou qualidade; coloca-se também entre certos verbos e o infinitivo que indica o objeto da ação."
   ],
   "nota": "Introduz o infinitivo e costuma corresponder a «de» em português: «le temps de se couler» é «o tempo de esgueirar-se»."
  },
  "d’": {
   "lema": "d’",
   "classe": "preposição",
   "forma": "elisão de «de»",
   "def": [
    "Elisão da preposição «de» diante de vogal ou de h mudo."
   ]
  },
  "d’#2": {
   "lema": "d’",
   "classe": "artigo partitivo",
   "forma": "elisão de «de»",
   "def": [
    "Elisão do artigo partitivo «de» diante de vogal ou de h mudo."
   ],
   "nota": "Indica quantidade indeterminada ou ausência: «peu d’amis» é «poucos amigos»; «d’autres fois», «outras vezes»."
  },
  "d’#3": {
   "lema": "d’",
   "classe": "preposição",
   "forma": "elisão de «de»",
   "def": [
    "Elisão da preposição «de» diante de vogal ou de h mudo. Seguida de infinitivo, liga a palavra anterior ao verbo."
   ],
   "nota": "Introduz o infinitivo: «afin d’éviter» é «para evitar»; «priait d’accepter», «pedia que aceitasse»."
  },
  "au": {
   "lema": "au",
   "classe": "artigo definido",
   "forma": "contração de «à» + «le»",
   "def": [
    "Contração da preposição «à» com o artigo definido «le»: ao, no."
   ]
  },
  "aux": {
   "lema": "aux",
   "classe": "artigo definido",
   "forma": "contração de «à» + «les»",
   "def": [
    "Contração obrigatória da preposição «à» com o artigo definido «les»: aos, às, nos, nas."
   ]
  },
  "en": {
   "lema": "en",
   "classe": "preposição",
   "def": [
    "Preposição que tem diversos usos especiais e precede muito frequentemente uma palavra que indica ou determina o estado, a maneira de ser, a disposição ou a modificação de uma pessoa ou coisa."
   ],
   "nota": "Em «en marche», «en bois», «en 1825», «en face»: em, de, a, conforme a expressão."
  },
  "en#2": {
   "lema": "en",
   "classe": "pronome pessoal",
   "def": [
    "(Substitui um complemento introduzido por «de») Disso, disto, daquilo."
   ],
   "nota": "Retoma algo já dito: «on lui en donnait quarante» é «davam-lhe quarenta (anos)»; «n’en comprenait pas le motif», «não entendia o motivo disso»."
  },
  "en#3": {
   "lema": "en",
   "classe": "preposição",
   "def": [
    "(Seguida do particípio presente) Preposição que serve para formar um gerúndio, que marca o tempo, a duração."
   ],
   "nota": "«En souriant» é «sorrindo»: a ação acontece ao mesmo tempo que a do verbo principal, ou diz o modo como ela se faz."
  },
  "en#4": {
   "lema": "en",
   "classe": "advérbio",
   "def": [
    "Daquele lugar, de lá."
   ],
   "nota": "Em «s’en aller» (ir-se embora) e «s’en retourner» (voltar), «en» marca a saída do lugar de que se fala."
  },
  "y": {
   "lema": "y",
   "classe": "advérbio",
   "def": [
    "Aqui, lá, naquele lugar."
   ]
  },
  "y#2": {
   "lema": "y",
   "classe": "pronome pessoal",
   "def": [
    "(Substitui um complemento inanimado introduzido por «à») A isto, a isso, a aquilo: nisso."
   ],
   "nota": "«Elle n’y comprenait rien»: não entendia nada daquilo."
  },
  "y#3": {
   "lema": "y avoir",
   "classe": "verbo",
   "forma": "impessoal («il y a», «il y avait», «il y eut»)",
   "def": [
    "Existir, ser: haver."
   ],
   "nota": "Em «il y a», «il y avait», «il y eut», o «y» não se traduz: a expressão equivale a «há», «havia», «houve»."
  },
  "lui": {
   "lema": "lui",
   "classe": "pronome pessoal",
   "forma": "3ª pessoa do singular, complemento indireto",
   "def": [
    "Pronome clítico da 3ª pessoa do singular, epiceno, de complemento indireto: lhe, a ele, a ela."
   ]
  },
  "lui#2": {
   "lema": "lui",
   "classe": "pronome pessoal",
   "forma": "3ª pessoa do singular masculino, forma tônica",
   "def": [
    "Pronome tônico da 3ª pessoa do singular masculino: ele."
   ]
  },
  "leur": {
   "lema": "leur",
   "classe": "determinante possessivo",
   "forma": "singular",
   "def": [
    "Que pertence a eles ou a elas. Vários possuidores e um só objeto possuído: seu, deles, delas."
   ]
  },
  "leur#2": {
   "lema": "leur",
   "classe": "pronome pessoal",
   "def": [
    "Pronome clítico da 3ª pessoa do plural: a eles ou a elas. Emprega-se sempre como complemento de atribuição: lhes."
   ]
  },
  "leurs": {
   "lema": "leur",
   "classe": "determinante possessivo",
   "forma": "plural",
   "def": [
    "Terceira pessoa do plural. Que pertence a eles. Vários possuidores e vários objetos possuídos: seus, deles, delas."
   ]
  }
 },
